{
  "name": "clockmath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages && node scripts/inject-api.js",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy": "npm test && npm run lint && node scripts/stale-check.mjs && node scripts/feedback.mjs --summary && npm run pages:build && wrangler pages deploy && node scripts/indexnow.js",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "spacing:audit": "node scripts/spacing-audit.js",
    "indexnow": "node scripts/indexnow.js",
    "test": "node --import ./tests/alias.mjs --test --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts && node scripts/worker/live-counts.test.js && node scripts/worker/stale-assets.test.js && node scripts/worker/api.test.js",
    "stale-check": "node scripts/stale-check.mjs",
    "feedback": "node scripts/feedback.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toast": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "geist": "1.4.2",
    "lucide-react": "^0.454.0",
    "next": "^15.5.28",
    "react": "^19",
    "react-day-picker": "9.8.0",
    "react-dom": "^19",
    "tailwind-merge": "^2.5.5",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "@cloudflare/next-on-pages": {
      "next": "$next",
      "@cloudflare/workers-types": "^5.20261019.1"
    }
  }
}
